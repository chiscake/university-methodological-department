<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailActionsPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="10" />
        <Setter Property="Margin" Value="36,0,36,24" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="DetailPrimaryActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="124" />
    </Style>

    <Style x:Key="DetailDangerActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="124" />
    </Style>

    <Style x:Key="DetailEditorContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="24,24,24,24" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="MinWidth" Value="{StaticResource DetailPageEditorColumnMinWidth}" />
        <Setter Property="MaxWidth" Value="640" />
    </Style>

</ResourceDictionary>
