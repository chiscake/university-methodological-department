<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UniversityMethodologicalDepartment.App.Controls.SemesterSelectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root">

    <StackPanel Spacing="6">
        <TextBlock x:Name="HeaderTextBlock"
                   Text="{Binding Header, ElementName=Root}" />
        <dev:SelectorBarSegmented x:Name="Selector"
                                  SelectionChanged="Selector_SelectionChanged">
            <SelectorBarItem Text="1" Tag="1" />
            <SelectorBarItem Text="2" Tag="2" />
            <SelectorBarItem Text="3" Tag="3" />
            <SelectorBarItem Text="4" Tag="4" />
            <SelectorBarItem Text="5" Tag="5" />
            <SelectorBarItem Text="6" Tag="6" />
            <SelectorBarItem Text="7" Tag="7" />
            <SelectorBarItem Text="8" Tag="8" />
            <SelectorBarItem Text="9" Tag="9" />
            <SelectorBarItem Text="10" Tag="10" />
            <SelectorBarItem Text="11" Tag="11" />
            <SelectorBarItem Text="12" Tag="12" />
        </dev:SelectorBarSegmented>
    </StackPanel>
</UserControl>
