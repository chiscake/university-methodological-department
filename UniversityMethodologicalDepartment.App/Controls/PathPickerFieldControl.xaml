<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="UniversityMethodologicalDepartment.App.Controls.PathPickerFieldControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title, Mode=OneWay, ElementName=Root}"
                   Style="{ThemeResource BodyLargeStrongTextBlockStyle}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox HorizontalAlignment="Stretch"
                     Width="{Binding PathBoxWidth, Mode=OneWay, ElementName=Root}"
                     IsReadOnly="True"
                     PlaceholderText="{Binding PlaceholderText, Mode=OneWay, ElementName=Root}"
                     Text="{Binding PathText, Mode=OneWay, ElementName=Root}" 
                     Grid.Column="0" />
            <Button Content="{Binding PickButtonText, Mode=OneWay, ElementName=Root}"
                    Command="{Binding PickCommand, Mode=OneWay, ElementName=Root}" 
                    Grid.Column="1" />
            <Button Content="{Binding CreateButtonText, Mode=OneWay, ElementName=Root}"
                    Command="{Binding CreateCommand, Mode=OneWay, ElementName=Root}"
                    CommandParameter="{Binding CreateCommandParameter, Mode=OneWay, ElementName=Root}"
                    Visibility="{Binding CreateCommand, Mode=OneWay, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}"
                    Grid.Column="2" />
        </Grid>
    </StackPanel>
</UserControl>
