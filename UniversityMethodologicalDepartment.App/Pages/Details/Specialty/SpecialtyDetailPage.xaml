<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UniversityMethodologicalDepartment.App.Views.Details.SpecialtyDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UniversityMethodologicalDepartment.App.Controls"
      xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
      xmlns:dev="using:DevWinUI"
      xmlns:vm="using:UniversityMethodologicalDepartment.App.ViewModels.Details"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="SpecialtyEditorTemplate"
                      x:DataType="vm:SpecialtyDetailPageViewModel">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding EditorStatusMessage, Mode=OneWay}"
                           Style="{StaticResource DetailStatusMessageTextStyle}"
                           Foreground="{Binding EditorStatusForeground, Mode=OneWay}" />
                <TextBox Header="Код специальности"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="Code"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Название специальности"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="Name"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Квалификация"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="Qualification"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.Qualification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Продолжительность (лет)"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="Duration"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Форма обучения"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="FormOfStudy"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.FormOfStudy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="DetailPageRoot"
          Style="{StaticResource DetailPageRootGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="{StaticResource DetailPageDetailsColumnMinWidth}" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0"
                      Grid.Row="0"
                      Style="{StaticResource DetailPageScrollViewerStyle}">
            <Border Style="{StaticResource DetailPageCardBorderStyle}">
                <StackPanel Style="{StaticResource DetailContentStackStyle}">
                    <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                        <TextBlock Text="Специальность"
                                   Style="{StaticResource DetailFieldLabelStyle}" />
                        <TextBlock x:Name="PageHeader"
                                   MaxWidth="720"
                                   AutomationProperties.HeadingLevel="Level1"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   Text="{Binding Title, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                               Style="{StaticResource DetailStatusMessageTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Style="{StaticResource DetailSectionPanelStyle}">
                        <TextBlock Text="Информация"
                                   Style="{StaticResource DetailSectionTitleStyle}" />
                        <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                            <TextBlock Text="Код"
                                       Style="{StaticResource DetailFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                                       Text="{Binding Specialty.Code, Mode=OneWay, FallbackValue='', Converter={StaticResource NullOrWhitespaceToPlaceholderConverter}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                            <TextBlock Text="Название"
                                       Style="{StaticResource DetailFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                                       Text="{Binding Specialty.Name, Mode=OneWay, FallbackValue='', Converter={StaticResource NullOrWhitespaceToPlaceholderConverter}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                            <TextBlock Text="Квалификация"
                                       Style="{StaticResource DetailFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                                       Text="{Binding Specialty.Qualification, Mode=OneWay, FallbackValue='', Converter={StaticResource NullOrWhitespaceToPlaceholderConverter}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                            <TextBlock Text="Срок обучения"
                                       Style="{StaticResource DetailFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailFieldValueStyle}">
                                <Run Text="{Binding Specialty.Duration, Mode=OneWay, FallbackValue=''}" />
                                <Run Text="лет" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                            <TextBlock Text="Форма обучения"
                                       Style="{StaticResource DetailFieldLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                                       Text="{Binding Specialty.FormOfStudy, Mode=OneWay, FallbackValue='', Converter={StaticResource NullOrWhitespaceToPlaceholderConverter}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource DetailSectionPanelStyle}">
                        <TextBlock Text="Элементы учебного плана"
                                   Style="{StaticResource DetailSectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding CurriculumItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <HyperlinkButton Style="{StaticResource DetailHyperlinkButtonStyle}"
                                                     Margin="0,0,0,4"
                                                     Command="{Binding DataContext.NavigateToCurriculumItemCommand, ElementName=DetailPageRoot}"
                                                     CommandParameter="{Binding}">
                                        <TextBlock>
                                            <Run Text="{Binding Discipline.Name, Mode=OneTime}" />
                                            <Run Text="| семестр" />
                                            <Run Text="{Binding Semester, Mode=OneTime}" />
                                        </TextBlock>
                                    </HyperlinkButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource DetailActionsPanelStyle}"
                    Visibility="{Binding CanShowActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Удалить"
                    Command="{Binding DeleteEntityCommand}" />
            <Button Content="Редактировать"
                    Command="{Binding OpenEditorCommand}" />
        </StackPanel>

        <ctk:GridSplitter Grid.Column="1"
                          Grid.RowSpan="2"
                          Style="{StaticResource DetailPageGridSplitterStyle}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding CanShowEditor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <controls:DetailEditorHost Grid.Column="2"
                                   Grid.RowSpan="2"
                                   Header="Редактирование специальности"
                                   IsOpen="{Binding CanShowEditor, Mode=OneWay}"
                                   CanSave="{Binding CanSaveEditor, Mode=OneWay}"
                                   IsBusy="{Binding IsSaving, Mode=OneWay}"
                                   SaveCommand="{Binding SaveEditorCommand}"
                                   CancelCommand="{Binding CloseEditorCommand}"
                                   EditorContent="{Binding}"
                                   EditorContentTemplate="{StaticResource SpecialtyEditorTemplate}" />
    </Grid>
</Page>
