<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UniversityMethodologicalDepartment.App.Views.Details.SectionDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:UniversityMethodologicalDepartment.App.Controls"
      xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
      xmlns:dev="using:DevWinUI"
      xmlns:vm="using:UniversityMethodologicalDepartment.App.ViewModels.Details"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="SectionEditorTemplate"
                      x:DataType="vm:SectionDetailPageViewModel">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding EditorStatusMessage, Mode=OneWay}"
                           Style="{StaticResource DetailStatusMessageTextStyle}"
                           Foreground="{Binding EditorStatusForeground, Mode=OneWay}" />
                <TextBox Header="Название секции"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="Name"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Телефоны"
                         Style="{StaticResource ValidatingTextBoxStyle}"
                         dev:Validation.ErrorTemplate="{StaticResource ValidationTemplate}"
                         dev:Validation.ValidationPropertyName="Phones"
                         dev:Validation.ValidationProvider="{Binding EditModel}"
                         Text="{Binding EditModel.Phones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="{x:Bind dev:PreviewKeyDownHelper.AcceptNumbersAndOperators}" />
                <AutoSuggestBox Header="Кафедра"
                                Text="{Binding DepartmentQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding DepartmentSuggestions, Mode=OneWay}"
                                TextMemberPath="Title"
                                TextChanged="DepartmentAutoSuggestBox_TextChanged"
                                SuggestionChosen="DepartmentAutoSuggestBox_SuggestionChosen"
                                QuerySubmitted="DepartmentAutoSuggestBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryHintTextStyle}"
                                           Text="{Binding Subtitle, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <AutoSuggestBox Header="Руководитель секции"
                                Text="{Binding HeadQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding HeadSuggestions, Mode=OneWay}"
                                TextMemberPath="Title"
                                TextChanged="HeadAutoSuggestBox_TextChanged"
                                SuggestionChosen="HeadAutoSuggestBox_SuggestionChosen"
                                QuerySubmitted="HeadAutoSuggestBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SecondaryHintTextStyle}"
                                           Text="{Binding Subtitle, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="DetailPageRoot"
          Style="{StaticResource DetailPageRootGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="{StaticResource DetailPageDetailsColumnMinWidth}" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0"
                      Grid.Row="0"
                      Style="{StaticResource DetailPageScrollViewerStyle}">
            <Border Style="{StaticResource DetailPageCardBorderStyle}">
                <StackPanel Style="{StaticResource DetailContentStackStyle}">
                <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                    <TextBlock Text="Секция"
                               Style="{StaticResource DetailFieldLabelStyle}" />
                    <TextBlock x:Name="PageHeader"
                               MaxWidth="720"
                               AutomationProperties.HeadingLevel="Level1"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Text="{Binding Title, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                           Style="{StaticResource DetailStatusMessageTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Style="{StaticResource DetailSectionPanelStyle}">
                    <!--<TextBlock Text="Информация"
                               Style="{StaticResource DetailSectionTitleStyle}" />-->
                    <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                    <TextBlock Text="Кафедра"
                               Style="{StaticResource DetailFieldLabelStyle}" />
                    <HyperlinkButton Style="{StaticResource DetailHyperlinkButtonStyle}"
                                     Command="{Binding NavigateToDepartmentCommand}"
                                     CommandParameter="{Binding Section.Department}">
                        <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                                   Text="{Binding Section.Department.Name, Mode=OneWay, FallbackValue='', Converter={StaticResource NullOrWhitespaceToPlaceholderConverter}}" />
                    </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                    <TextBlock Text="Руководитель"
                               Style="{StaticResource DetailFieldLabelStyle}" />
                    <HyperlinkButton Style="{StaticResource DetailHyperlinkButtonStyle}"
                                     Visibility="{Binding HasHead, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Command="{Binding NavigateToEmployeeCommand}"
                                     CommandParameter="{Binding Section.Head}">
                        <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                                   Text="{Binding HeadDisplayLine, Mode=OneWay}" />
                    </HyperlinkButton>
                    <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                               Visibility="{Binding IsHeadMissing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               Text="Не указан" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                        <TextBlock Text="Сотрудники"
                                   Style="{StaticResource DetailFieldLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding Section.Employees, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <HyperlinkButton Style="{StaticResource DetailHyperlinkButtonStyle}"
                                                     Margin="0,0,0,4"
                                                     Command="{Binding DataContext.NavigateToEmployeeCommand, ElementName=DetailPageRoot}"
                                                     CommandParameter="{Binding}">
                                        <TextBlock>
                                            <Run Text="{Binding Surname, Mode=OneTime}" />
                                            <Run Text="{Binding Name, Mode=OneTime}" />
                                            <Run Text="{Binding Patronymic, Mode=OneTime}" />
                                        </TextBlock>
                                    </HyperlinkButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource DetailSectionPanelStyle}">
                    <TextBlock Text="Контакты"
                               Style="{StaticResource DetailSectionTitleStyle}" />
                    <StackPanel Style="{StaticResource DetailFieldPanelStyle}">
                    <TextBlock Text="Телефоны"
                               Style="{StaticResource DetailFieldLabelStyle}" />
                    <TextBlock Style="{StaticResource DetailFieldValueStyle}"
                               Text="{Binding Section.Phones, Mode=OneWay, FallbackValue='', Converter={StaticResource NullOrWhitespaceToPlaceholderConverter}}" />
                </StackPanel>
                </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource DetailActionsPanelStyle}"
                    Visibility="{Binding CanShowActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Удалить"
                    Style="{StaticResource DetailDangerActionButtonStyle}"
                    Command="{Binding DeleteEntityCommand}" />
            <Button Content="Редактировать"
                    Command="{Binding OpenEditorCommand}" />
        </StackPanel>

        <ctk:GridSplitter Grid.Column="1"
                Grid.RowSpan="2"
                      Style="{StaticResource DetailPageGridSplitterStyle}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding CanShowEditor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <controls:DetailEditorHost Grid.Column="2"
                                   Grid.RowSpan="2"
                                   Header="Редактирование секции"
                                   IsOpen="{Binding CanShowEditor, Mode=OneWay}"
                                   CanSave="{Binding CanSaveEditor, Mode=OneWay}"
                                   IsBusy="{Binding IsSaving, Mode=OneWay}"
                                   SaveCommand="{Binding SaveEditorCommand}"
                                   CancelCommand="{Binding CloseEditorCommand}"
                                   EditorContent="{Binding}"
                                   EditorContentTemplate="{StaticResource SectionEditorTemplate}" />
    </Grid>
</Page>
