<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UniversityMethodologicalDepartment.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!--  Эти стили обеспечивают единообразие оформления страницы настроек  -->
        <!--  См. пример SettingsExpander Page в Windows Community Toolkit Gallery для полного варианта  -->

        <!--  Отступ между карточками  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Стиль (вкл. правильный отступ) для заголовка секции  -->
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin"
                        Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageHeader"
                   MaxWidth="1064"
                   Margin="36,24,36,0"
                   AutomationProperties.HeadingLevel="Level1"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Text="Настройки" />
        <ScrollView Grid.Row="1"
                    Padding="36,0,36,0"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
            <Border>
                <StackPanel MaxWidth="1064"
                            Spacing="{StaticResource SettingsCardSpacing}">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition />
                    </StackPanel.ChildrenTransitions>
                    
                    <!--Настройки-->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="Внешний вид и поведение" />
                    <toolkit:SettingsCard Header="Тема приложения">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="themeMode"
                                  AutomationProperties.AutomationId="themeModeComboBox"
                                  SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Светлая"
                                          Tag="Light" />
                            <ComboBoxItem Content="Тёмная"
                                          Tag="Dark" />
                            <ComboBoxItem Content="Использовать настройку системы"
                                          Tag="Default" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="Стиль навигации">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF594;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="navigationLocation"
                                  SelectedIndex="{Binding NavigationSelectedIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Слева" />
                            <ComboBoxItem Content="Сверху" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="Списки" />
                    <toolkit:SettingsCard Header="Записей на странице"
                                          Description="Размер страницы для справочников и результатов поиска.">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE14C;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <NumberBox Minimum="1"
                                   Maximum="500"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{Binding ListPageSize, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="Подключение к базе данных" />
                    <toolkit:SettingsCard Description="{Binding ConnectionSourceDescription}"
                                          Header="Строка подключения PostgreSQL">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE968;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding ConnectionStatusMessage}"
                                       TextWrapping="WrapWholeWords"
                                       Visibility="{Binding HasConnectionStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <PasswordBox x:Name="ConnectionStringPasswordBox"
                                         PasswordChanged="ConnectionStringPasswordBox_PasswordChanged"
                                         PlaceholderText="" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button Command="{Binding ClearSavedConnectionCommand}"
                                        Content="Сбросить сохранённое" />
                                <Button Command="{Binding TestConnectionCommand}"
                                        Content="Проверить подключение"
                                        IsEnabled="{Binding IsConnectionTestIdle}" />
                                <Button Command="{Binding CancelConnectionDraftCommand}"
                                        Content="Отмена" />
                                <Button Command="{Binding SaveConnectionCommand}"
                                        Content="Сохранить"
                                        Style="{StaticResource AccentButtonStyle}" />

                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="hardResetCard" 
                                          Header="Сбросить данные приложения"
                                          Visibility="Collapsed"
                                          Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72C;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button x:Name="hardResetButton"
                                Content="Сбросить"
                                Command="{Binding HardResetCommand}"/>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="Учетная запись">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button Content="Выйти из аккаунта"
                                Command="{Binding LogoutCommand}" />
                    </toolkit:SettingsCard>

                    <!--  О приложении  -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="О программе" />
                    <toolkit:SettingsExpander Margin="0,0,0,36"
                                              Description="© 2026 ChisCake."
                                              Header="{StaticResource AppTitleName}">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <BitmapIcon ShowAsMonochrome="False"
                                        UriSource="/Assets/Tiles/BadgeLogo.png" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{Binding Version}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard x:Name="toCloneRepoCard"
                                                  Click="ToCloneRepoCard_Click"
                                                  Header="Клонировать этот репозиторий"
                                                  IsClickEnabled="True">
                                <TextBlock x:Name="gitCloneTextBlock"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextSelectionEnabled="True"
                                           Text="{Binding GitCloneText}" />
                                <toolkit:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </toolkit:SettingsCard.ActionIcon>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                                  ContentAlignment="Vertical"
                                                  Header="Зависимости и ссылки">
                                <StackPanel Margin="-12,0,0,0"
                                            Orientation="Vertical">
                                    <HyperlinkButton Content="CommunityToolkit.Mvvm"
                                                     NavigateUri="https://www.nuget.org/packages/CommunityToolkit.Mvvm" />
                                    <HyperlinkButton Content="CommunityToolkit.WinUI.Controls.Primitives"
                                                     NavigateUri="https://www.nuget.org/packages/CommunityToolkit.WinUI.Controls.Primitives" />
                                    <HyperlinkButton Content="CommunityToolkit.WinUI.Controls.Segmented"
                                                     NavigateUri="https://www.nuget.org/packages/CommunityToolkit.WinUI.Controls.Segmented" />
                                    <HyperlinkButton Content="CommunityToolkit.WinUI.Controls.SettingsControls"
                                                     NavigateUri="https://www.nuget.org/packages/CommunityToolkit.WinUI.Controls.SettingsControls" />
                                    <HyperlinkButton Content="CommunityToolkit.WinUI.Controls.Sizers"
                                                     NavigateUri="https://www.nuget.org/packages/CommunityToolkit.WinUI.Controls.Sizers" />
                                    <HyperlinkButton Content="CredentialManagement"
                                                     NavigateUri="https://www.nuget.org/packages/CredentialManagement" />
                                    <HyperlinkButton Content="coverlet.collector"
                                                     NavigateUri="https://www.nuget.org/packages/coverlet.collector" />
                                    <HyperlinkButton Content="DevWinUI"
                                                     NavigateUri="https://www.nuget.org/packages/DevWinUI" />
                                    <HyperlinkButton Content="DevWinUI.Controls"
                                                     NavigateUri="https://www.nuget.org/packages/DevWinUI.Controls" />
                                    <HyperlinkButton Content="DocumentFormat.OpenXml"
                                                     NavigateUri="https://www.nuget.org/packages/DocumentFormat.OpenXml" />
                                    <HyperlinkButton Content="LiveChartsCore.SkiaSharpView.WinUI"
                                                     NavigateUri="https://www.nuget.org/packages/LiveChartsCore.SkiaSharpView.WinUI" />
                                    <HyperlinkButton Content="Microsoft.EntityFrameworkCore"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.EntityFrameworkCore" />
                                    <HyperlinkButton Content="Microsoft.EntityFrameworkCore.Design"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.EntityFrameworkCore.Design" />
                                    <HyperlinkButton Content="Microsoft.EntityFrameworkCore.Relational"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.EntityFrameworkCore.Relational" />
                                    <HyperlinkButton Content="Microsoft.Extensions.Configuration"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Extensions.Configuration" />
                                    <HyperlinkButton Content="Microsoft.Extensions.Configuration.Abstractions"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Extensions.Configuration.Abstractions" />
                                    <HyperlinkButton Content="Microsoft.Extensions.Configuration.Binder"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Extensions.Configuration.Binder" />
                                    <HyperlinkButton Content="Microsoft.Extensions.Configuration.Json"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Extensions.Configuration.Json" />
                                    <HyperlinkButton Content="Microsoft.Extensions.DependencyInjection"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Extensions.DependencyInjection" />
                                    <HyperlinkButton Content="Microsoft.NET.Test.Sdk"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.NET.Test.Sdk" />
                                    <HyperlinkButton Content="Microsoft.Windows.CsWin32"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Windows.CsWin32" />
                                    <HyperlinkButton Content="Microsoft.Windows.SDK.BuildTools"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.Windows.SDK.BuildTools" />
                                    <HyperlinkButton Content="Microsoft.WindowsAppSDK"
                                                     NavigateUri="https://www.nuget.org/packages/Microsoft.WindowsAppSDK" />
                                    <HyperlinkButton Content="Npgsql.EntityFrameworkCore.PostgreSQL"
                                                     NavigateUri="https://www.nuget.org/packages/Npgsql.EntityFrameworkCore.PostgreSQL" />
                                    <HyperlinkButton Content="Supabase"
                                                     NavigateUri="https://www.nuget.org/packages/Supabase" />
                                    <HyperlinkButton Content="xunit.runner.visualstudio"
                                                     NavigateUri="https://www.nuget.org/packages/xunit.runner.visualstudio" />
                                    <HyperlinkButton Content="xunit.v3"
                                                     NavigateUri="https://www.nuget.org/packages/xunit.v3" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard HorizontalContentAlignment="Left"
                                                  ContentAlignment="Vertical"
                                                  Header="ДАННЫЙ КОД И ИНФОРМАЦИЯ ПРЕДОСТАВЛЯЮТСЯ «КАК ЕСТЬ», БЕЗ КАКИХ-ЛИБО ГАРАНТИЙ, В ТОМ ЧИСЛЕ БЕЗ ГАРАНТИЙ КОММЕРЧЕСКОЙ ПРИГОДНОСТИ И/ИЛИ ПРИГОДНОСТИ ДЛЯ ОПРЕДЕЛЁННОЙ ЦЕЛИ.">
                                <StackPanel Margin="-12,0,0,0"
                                            Orientation="Vertical">
                                    <HyperlinkButton Content="Репозиторий GitHub"
                                                     NavigateUri="https://github.com/chisCake/university-methodological-department" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                </StackPanel>
            </Border>
        </ScrollView>
    </Grid>
</Page>
