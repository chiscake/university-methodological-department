<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversityMethodologicalDepartment.App.Pages.Analytics.QueriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UniversityMethodologicalDepartment.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Text="Аналитические запросы" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">
            <ComboBox Width="520"
                      ItemsSource="{Binding QueryOptions, Mode=OneWay}"
                      SelectedItem="{Binding SelectedQuery, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      VerticalAlignment="Bottom"
                      Header="Тип запроса" />
            <Button Content="Выполнить"
                    Command="{Binding ExecuteQueryCommand}"
                    VerticalAlignment="Bottom" />
            <ComboBox Width="200"
                      Header="Формат экспорта"
                      ItemsSource="{Binding ExportFormatOptions, Mode=OneWay}"
                      SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}"
                      DisplayMemberPath="Title" />
            <Button Content="Экспорт в файл…"
                    Command="{Binding ExportResultsCommand}"
                    VerticalAlignment="Bottom" />
        </StackPanel>

        <!--<TextBlock Grid.Row="2"
                   Text="Экспортируются строки из списка ниже (тот же сценарий, что в предпросмотре после «Выполнить»). Выберите Word или Excel и папку сохранения."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />-->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8">
            <ComboBox Width="300"
                      Visibility="{Binding DepartmentControlsVisibility, Mode=OneWay}"
                      ItemsSource="{Binding Departments, Mode=OneWay}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedDepartmentId, Mode=TwoWay}"
                      VerticalAlignment="Bottom"
                      Header="Кафедра:"/>
            <controls:SemesterSelectorControl Visibility="{Binding SemesterControlsVisibility, Mode=OneWay}"
                                              SelectedSemester="{Binding SelectedSemester, Mode=TwoWay}"
                                              VerticalAlignment="Bottom"/>
        </StackPanel>

        <ListView Grid.Row="4"
                  ItemsSource="{Binding Results, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" MinWidth="240" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Primary}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Secondary}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Details}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="3" Text="{Binding Extra}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Spacing="8">
            <ProgressRing Width="18"
                          Height="18"
                          IsActive="{Binding IsBusy, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
