<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversityMethodologicalDepartment.App.Pages.Analytics.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Text="Отчёты и экспорт" />

        <TextBlock Grid.Row="1"
                   Text="Сначала сформируйте предпросмотр. Затем при необходимости сохраните отчёт в файл."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
            <ComboBox Width="520"
                      ItemsSource="{Binding ReportTemplates, Mode=OneWay}"
                      DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
            <Button Content="Выполнить"
                    Command="{Binding BuildPreviewCommand}" />
            <Button Content="Экспорт в файл…"
                    Command="{Binding ExportToFileCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Кафедры -->
                <StackPanel Grid.Row="0"
                            Spacing="8"
                            Visibility="{Binding PreviewDepartmentsVisible, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}"
                               Text="Предпросмотр: кафедры" />
                    <Grid Padding="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Padding="4"
                              Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="140" />
                                <ColumnDefinition Width="3*" MinWidth="200" />
                                <ColumnDefinition Width="2*" MinWidth="160" />
                                <ColumnDefinition Width="2*" MinWidth="140" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Факультет" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Кафедра" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Заведующий" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Телефон(ы)" />
                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Сотрудн." />
                            <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Дисципл." />
                        </Grid>
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding DepartmentPreviewRows, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                            <ColumnDefinition Width="3*" MinWidth="200" />
                                            <ColumnDefinition Width="2*" MinWidth="160" />
                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FacultyName}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DepartmentName}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding HeadFullName}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Phones}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding EmployeeCount}" />
                                        <TextBlock Grid.Column="5"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DisciplineCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>

                <!-- Матрица по специальности -->
                <StackPanel Grid.Row="1"
                            Spacing="8"
                            Visibility="{Binding PreviewMatrixVisible, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}"
                               Text="Предпросмотр: часы по специальностям" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Специальность:" />
                        <ComboBox Width="520"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedSpecialtyId, Mode=TwoWay}"
                                  ItemsSource="{Binding SpecialtyOptions, Mode=OneWay}" />
                    </StackPanel>
                    <Grid Padding="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Padding="4"
                              Background="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" MinWidth="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Дисциплина" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Лек." FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Лаб." FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Практ." FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="УСР" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Зачёт" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="Экз." FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="КП" FontWeight="SemiBold" />
                        </Grid>
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding MatrixPreviewRows, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" MinWidth="260" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisciplineLabel}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding LectureHours}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LabHours}" />
                                        <TextBlock Grid.Column="3" Text="{Binding PracticalHours}" />
                                        <TextBlock Grid.Column="4" Text="{Binding UsrHours}" />
                                        <TextBlock Grid.Column="5" Text="{Binding CreditMark}" />
                                        <TextBlock Grid.Column="6" Text="{Binding ExamMark}" />
                                        <TextBlock Grid.Column="7" Text="{Binding CourseMark}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>

                <!-- Word -->
                <StackPanel Grid.Row="2"
                            Spacing="12"
                            Visibility="{Binding PreviewWordVisible, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}"
                               Text="Предпросмотр: отчёт по кафедрам" />
                    <ItemsControl ItemsSource="{Binding WordSections, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="8" Margin="0,0,0,16">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding DepartmentName}" />
                                    <Grid Padding="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0"
                                              Padding="4"
                                              Background="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" MinWidth="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Дисциплина" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Семестры" />
                                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Специальности" />
                                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Форма контроля" />
                                        </Grid>
                                        <ListView Grid.Row="1"
                                                  ItemsSource="{Binding Rows}"
                                                  SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*" MinWidth="220" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DisciplineName}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Semesters}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Specialties}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ControlForms}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="8">
            <ProgressRing Width="18"
                          Height="18"
                          IsActive="{Binding IsBusy, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
