<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UniversityMethodologicalDepartment.App.Views.HomePage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:dev="using:DevWinUI"
      xmlns:home="using:UniversityMethodologicalDepartment.App.Pages.Home"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Page.Resources>
        <SolidColorBrush x:Key="HeaderWhite"
                         Color="White" />
    </Page.Resources>

    <dev:MainLandingPage x:Name="mainLanding"
                         HeaderText=""
                         HeaderSubtitleText=""
                         Stretch="UniformToFill"
                         HeaderImageHeight="300">
        <dev:MainLandingPage.HeaderContent>
            <StackPanel Orientation="Vertical"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="24,0,0,0">
                <!-- Подзаголовок: CompositionShadow + белый текст -->
                <dev:CompositionShadow BlurRadius="6"
                                       OffsetX="2"
                                       OffsetY="2"
                                       ShadowOpacity="1">
                    <TextBlock Text="Автоматизированная информационная система"
                               Foreground="{StaticResource HeaderWhite}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="14"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap" />
                </dev:CompositionShadow>
                <!-- Заголовок: CompositionShadow (размытая тень) + белый текст -->
                <dev:CompositionShadow BlurRadius="8"
                                       OffsetX="2"
                                       OffsetY="2"
                                       ShadowOpacity="0.8">
                    <TextBlock Text="{StaticResource AppTitleName}"
                               Foreground="{StaticResource HeaderWhite}"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap" />
                </dev:CompositionShadow>
            </StackPanel>
        </dev:MainLandingPage.HeaderContent>
        <dev:MainLandingPage.FooterContent>
            <StackPanel Spacing="20"
                        Margin="0,0,0,8">
                <Border BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.AuthPromptVisibility, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Требуется авторизация"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Войдите в систему, чтобы получить доступ к персональным и административным функциям."
                                   Opacity="0.85"
                                   TextWrapping="WrapWholeWords" />
                        <Button Content="Перейти к авторизации"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.GoToLoginCommand}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12">
                    <TextBlock Text="Справочники"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ReferenceCards, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="308"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="home:HomeQuickAccessCard">
                                <Button Margin="0,0,10,10"
                                        Width="298"
                                        Style="{StaticResource HomeQuickAccessButtonStyle}"
                                        Click="QuickAccessCardButton_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontSize="16"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource HomeQuickAccessTitleStyle}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource HomeQuickAccessDescriptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Аналитика и отчёты"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AnalyticsCards, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="308"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="home:HomeQuickAccessCard">
                                <Button Margin="0,0,10,10"
                                        Width="298"
                                        Style="{StaticResource HomeQuickAccessButtonStyle}"
                                        Click="QuickAccessCardButton_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontSize="16"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource HomeQuickAccessTitleStyle}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource HomeQuickAccessDescriptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.AdminSectionVisibility, Mode=OneWay}">
                    <TextBlock Text="Администрирование"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AdminCards, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="308"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="home:HomeQuickAccessCard">
                                <Button Margin="0,0,10,10"
                                        Width="298"
                                        Style="{StaticResource HomeQuickAccessButtonStyle}"
                                        Click="QuickAccessCardButton_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}"
                                                  FontSize="16"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource HomeQuickAccessTitleStyle}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource HomeQuickAccessDescriptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </dev:MainLandingPage.FooterContent>
    </dev:MainLandingPage>
</Page>
