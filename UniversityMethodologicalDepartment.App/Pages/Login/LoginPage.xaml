<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UniversityMethodologicalDepartment.App.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="using:UniversityMethodologicalDepartment.App.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:LoginPageViewModel}"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                MaxWidth="420"
                MinWidth="320"
                Padding="24"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                           Text="Вход в систему" />

                <TextBox Header="Email"
                         PlaceholderText="user@example.com"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox x:Name="PasswordBox"
                             Header="Пароль" />

                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{Binding ErrorMessage, Mode=OneWay}"
                           TextWrapping="WrapWholeWords"
                           Visibility="{Binding HasErrorMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Orientation="Vertical"
                            Spacing="12"
                            HorizontalAlignment="Center">
                    <Button Content="Войти"
                            Command="{Binding SignInCommand}"
                            CommandParameter="{Binding ElementName=PasswordBox, Path=Password, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Width="120" />

                </StackPanel>
                <ProgressRing IsActive="{Binding IsBusy, Mode=OneWay}"
                              Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
