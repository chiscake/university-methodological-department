<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UniversityMethodologicalDepartment.App.Views.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">
    <Grid Style="{StaticResource AdminPageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Журнал"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Обновить"
                    Command="{Binding LoadCommand}" />
            <ProgressRing Width="20"
                          Height="20"
                          IsActive="{Binding IsLoading}" />
            <TextBlock Style="{StaticResource AdminToolbarStatusTextStyle}"
                       Text="{Binding StatusMessage}" />
        </StackPanel>

        <Grid Grid.Row="2"
              Style="{StaticResource AdminMasterDetailGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Items, Mode=OneWay}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowSpacing="4" Padding="0,8,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding OccurredAt, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Action, Mode=OneWay}" />
                                <Run Text="•" />
                                <Run Text="{Binding TableName, Mode=OneWay}" />
                                <Run Text="• ID:" />
                                <Run Text="{Binding EntityId, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Пользователь: " />
                                <Run Text="{Binding ActorUserId, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1"
                    Style="{StaticResource AdminDetailsCardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource AdminSectionTitleTextStyle}"
                                   Text="Детали записи" />

                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailsOccurredAt, Mode=OneWay}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Действие:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailsAction, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Таблица:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailsTableName, Mode=OneWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ID:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailsEntityId, Mode=OneWay}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Пользователь:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailsActorUserId, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Text="Старые данные" FontWeight="SemiBold" />
                        <TextBox Text="{Binding DetailsOldRow, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="130"
                                 FontFamily="Cascadia Mono" />

                        <TextBlock Text="Новые данные" FontWeight="SemiBold" />
                        <TextBox Text="{Binding DetailsNewRow, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="130"
                                 FontFamily="Cascadia Mono" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
